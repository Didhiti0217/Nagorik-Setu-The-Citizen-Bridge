# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Gemma 4 provider ---------------------------------------------------
# aistudio | ollama | mock
GEMMA_PROVIDER=aistudio

# AI Studio (hosted).
# Verified 2026-07-24: our key exposes ONLY gemma-4-26b-a4b-it and gemma-4-31b-it.
# Neither accepts audio (audio is E2B/E4B/12B only) — see progress notes.
# 26b-a4b is a 3.8B-active MoE, so it is the faster of the two.
GEMMA_MODEL=gemma-4-26b-a4b-it
GOOGLE_API_KEY=

# Ollama (local / offline demo). Requires Ollama >= 0.22.
# NOTE: audio MUST go through /v1/chat/completions — the native /api/chat
# silently ignores audio. See CLAUDE.md.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# --- inference tuning ---------------------------------------------------
GEMMA_TIMEOUT_MS=60000
GEMMA_MAX_RETRIES=3

# --- data ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/nagorik-setu

# --- server -------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Absolute origin of the deployed frontend, used to build admin invite links.
# CLIENT_ORIGIN may be "*" (a CORS wildcard), which is useless for building a
# URL — hence a separate variable.
PUBLIC_APP_URL=http://localhost:5173

# --- auth ---------------------------------------------------------------
# HS256 signing secret for session tokens. Generate with:
#   openssl rand -base64 48
# The server REFUSES TO START if this is unset or shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Demo mode returns the OTP in the API response and shows it on screen, so a
# judge can sign in without a Bangladeshi SIM. The server REFUSES TO START if
# this is true while OTP_SENDER is anything other than "demo" — that pairing is
# a log-in-as-anyone oracle.
AUTH_DEMO_MODE=true

# --- OTP ----------------------------------------------------------------
# demo | (add your gateway to server/src/services/otpSender.js)
OTP_SENDER=demo
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- admin accounts -----------------------------------------------------
# Consumed by `npm run seed:admins`. One entry per city corporation:
#   <corporationId>:<email>[:<password>]   separated by ';'
# Corporation ids: gazipur, dhaka-north, dhaka-south, narayanganj, chattogram
# Password falls back to ADMIN_SEED_PASSWORD; if that is empty too the script
# generates one and prints it ONCE.
ADMIN_SEED=gazipur:gcc@nagoriksetu.demo;dhaka-north:dncc@nagoriksetu.demo
ADMIN_SEED_PASSWORD=

# --- invites / stream ---------------------------------------------------
INVITE_TTL_HOURS=72
# Browser EventSource cannot send an Authorization header, so the dashboard
# trades its session token for a short-lived, stream-only ticket.
STREAM_TICKET_TTL_SECONDS=900
