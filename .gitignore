# --- secrets: never commit. This repo becomes PUBLIC for judging. ---
# A credential pushed once cannot be un-published by deleting the file later;
# it stays in git history. These patterns are matched at ANY depth.
.env
.env.*
# Catch ANY *.env file at any depth (atlas-credentials.env, db.env, prod.env…).
# The committed example ends in .example, so it is not matched.
*.env
!.env.example
!*.env.example
secrets.env
**/secrets.env
secret*.env
*secrets*.env
*.secrets
# "credentials" anywhere in the name, not only as a prefix.
credentials*
*credentials*
*.pem
*.key
kaggle.json
.kaggle/

# --- dependencies ---
node_modules/
.pnp
.pnp.js

# --- build output ---
dist/
build/
.vite/

# --- uploads / runtime data ---
server/uploads/
*.log
npm-debug.log*

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- eval scratch ---
eval/out/
