# Copy to .env for local dev, or set in your host's dashboard for production.

# Base URL of the Nagorik Setu API.
# Leave EMPTY in local dev — vite.config.js proxies /api to VITE_DEV_API instead.
# In production set it to the deployed API origin, e.g.:
VITE_API_BASE=https://nagorik-setu-api.onrender.com

# Where the dev proxy points when VITE_API_BASE is empty.
VITE_DEV_API=http://localhost:4000

# Map starting view — Gazipur City Corporation.
VITE_MAP_CENTER_LNG=90.4125
VITE_MAP_CENTER_LAT=23.9999
VITE_MAP_ZOOM=11
